{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent Fabric (Terminal)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--agent",
        "${input:agentId}"
      ]
    },
    {
      "name": "Agent Fabric walkthrough (read-only)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "--request",
        "examples/request.json",
        "--query",
        "What is the refund status of order 1002?"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "stopOnEntry": true,
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ],
  "inputs": [
    {
      "id": "agentId",
      "type": "promptString",
      "description": "Enter the agent ID to run (required)."
    }
  ]
}
